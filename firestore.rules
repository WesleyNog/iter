rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // O app grava user/{uid} no primeiro login (GoogleSignInService).
    // Cada usuário só lê e escreve o próprio documento.
    match /user/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
