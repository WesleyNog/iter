<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Exigidas pelo geolocator (postos por perto no abastecimento).
         COARSE junto com FINE de propósito: no Android 12+ o usuário pode
         conceder só a aproximada, e ~100 m basta para achar o posto. Sem
         declarar as duas, negar a precisa derrubaria o recurso inteiro. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Exigida pelo mobile_scanner (ler o QR Code de um amigo). O
         image_picker não a declara: ele delega a foto ao app de câmera do
         sistema, que tira a foto com a permissão dele. Ler QR é diferente —
         o app recebe o fluxo da câmera, e aí a permissão é nossa. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:label="iter"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Notificações push (FCM). Ver docs/specs/notificacoes.md.

             O ícone é obrigatório: sem ele o FCM cai no ic_launcher, que é 100%
             opaco, e o sistema — que usa só o canal alpha — desenha um quadrado
             branco em todo Android 5+.

             Ícone e cor por android:resource; o canal por android:value, que é
             o que o Firebase espera de cada um. Cor escrita como valor literal
             é lida com Bundle.getInt, devolve 0 e é ignorada em silêncio.

             O id do canal repete a constante CANAL_SOCIAL de MainActivity.kt,
             que é quem de fato o cria — este meta-data só aponta. Os dois mudam
             juntos, e depois do primeiro install não mudam mais. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_iter" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificacao" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="iter_social" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
