{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "iter-mn",
          "appId": "1:87511151381:android:e334b8396d0167256d6f1c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "iter-mn",
          "appId": "1:87511151381:ios:b851dbb61065b7476d6f1c",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "iter-mn",
          "configurations": {
            "android": "1:87511151381:android:e334b8396d0167256d6f1c",
            "ios": "1:87511151381:ios:b851dbb61065b7476d6f1c"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "test"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "site",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "**/.*"
    ]
  }
}
