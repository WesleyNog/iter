rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueio entre duas pessoas, nas duas direções.
    //
    // Uma função e não a condição copiada: o convite mora em **duas** matches
    // (`incoming` e `outgoing`) que precisam decidir a mesma coisa sobre o
    // mesmo par. Um invariante que vale só num dos dois documentos do batch é
    // um invariante que some na primeira mexida — a mesma razão de o
    // `friendId != userId` continuar escrito mesmo sendo redundante.
    function bloqueioEntre(database, a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a)/list/$(b))
             || exists(/databases/$(database)/documents/blocks/$(b)/list/$(a));
    }

    // Uma denúncia aponta para um comentário ou para o post inteiro, e é a
    // ausência de `commentId` que diz qual — não um campo `tipo` que o cliente
    // preencheria de um jeito e o alvo de outro.
    function denunciaDeComentario(data) {
      return 'commentId' in data && data.commentId != null;
    }

    // O id da denúncia, e ele carrega o **tipo** do alvo.
    //
    // Sem o prefixo, post e comentário dividiam o mesmo espaço de nomes e os
    // dois ids são escolhidos pelo cliente: bastava criar um comentário com o
    // id de um post para a segunda denúncia sobrescrever a primeira em
    // silêncio, numa coleção onde `delete: if false` promete o contrário.
    //
    // O `_` como separador só é seguro porque o `create` de `posts` e o de
    // `comments` recusam id que o contenha — senão `c_a_b_c` sairia de dois
    // pares diferentes de (post, comentário).
    function idDaDenuncia(data, uid) {
      return (denunciaDeComentario(data)
                ? 'c_' + data.postId + '_' + data.commentId
                : 'p_' + data.postId)
             + '__' + uid;
    }

    // O admin do painel de moderação (`site/admin.html`) — uma conta só,
    // decidida pelo uid. Ver `docs/specs/painel-admin.md`.
    //
    // Uid fixo e não custom claim, de propósito: gravar um claim exige uma
    // service-account key, que seria o artefato mais perigoso do projeto em
    // disco, e uid não é segredo — o `list` de `posts` entrega o de qualquer
    // um que publique. Se um dia houver um segundo moderador, esta função
    // vira `request.auth.token.admin == true` num commit só.
    //
    // O MESMO uid está em `storage.rules` (duas matches: o delete em
    // `posts/{uid}/…` e a leitura de `quarentena/…`), que não enxerga este
    // arquivo — mudar as três cópias juntas, como o regex de apelido que
    // vive aqui e em `NicknameController`. Os testes extraem o literal
    // desta função do próprio arquivo, então trocar o uid não os
    // dessincroniza.
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'nn0pMX9g14WP4T0KSVbJoV2A2pl2';
    }

    // O app grava user/{uid} no primeiro login (GoogleSignInService).
    // Cada usuário só lê e escreve o próprio documento.
    match /user/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Token de notificação ──────────────────────────────────────────────
    //
    // `fcmTokens/{sha256(token)}` -> `{token, uid, platform, updatedAt}`.
    //
    // **A chave é o aparelho, não o dono**, e é o oposto do que a intuição
    // pede. O token do FCM identifica a *instalação do app*, não a pessoa: com
    // o uid no prefixo — `user/{uid}/tokens/{token}` —, `user/A/tokens/T` e
    // `user/B/tokens/T` seriam dois documentos diferentes, e o Firestore ficaria
    // **estruturalmente incapaz** de impedir o mesmo celular sob dois donos ao
    // mesmo tempo. Que é o bug do aparelho emprestado: A sai, B entra, e A
    // continua recebendo os convites dele no telefone do B.
    //
    // Com o token como id os dois caminhos viram um documento só e a colisão
    // some por forma — a técnica de `nicknames/{apelido}`, com uma diferença
    // deliberada: aqui o `update` é **permitido**. A reivindicação legítima é de
    // quem está com o aparelho na mão e autenticado agora, e é isso que faz o
    // **login** restabelecer o invariante sozinho, mesmo quando o logout falhou.
    //
    // O id é o sha256 em hexa, e não o token cru: o Google trata o token como
    // string opaca e não promete alfabeto nenhum. Um token que um dia venha com
    // `/` seria id inválido, e a falha seria silenciosa e permanente naquele
    // aparelho. 64 caracteres de `[0-9a-f]` custam zero e prendem o wildcard —
    // sem isso a coleção é depósito livre na cota do projeto, como o comentário
    // de `profiles/{uid}/stats/{bucket}` já registra.
    //
    // O que esta regra garante, e uma versão anterior deste comentário dizia
    // que não: **o id é o hash do token, conferido aqui**. Sem isso, "a colisão
    // some por forma" seria promessa do app, não invariante — bastava um cliente
    // gravar o mesmo token sob dois ids para dois donos receberem no mesmo
    // aparelho, que é o caso inteiro que a chave invertida existe para fechar.
    //
    // O que ela continua **não** garantindo: ela não amarra o token a um
    // aparelho. Quem soubesse o token do celular de outra pessoa poderia
    // reivindicá-lo com o próprio uid e desviar as próprias notificações para
    // lá. Tokens não são públicos e nenhum caminho do app os expõe; sem servidor
    // de atestação não há defesa melhor.
    //
    // Ver `docs/specs/notificacoes.md`.
    match /fcmTokens/{tokenId} {
      // Ninguém lê, nem o dono. O app só escreve, e quem lê é o Admin SDK, que
      // não passa por aqui. Uma coleção de tokens legível é o mapa dos
      // aparelhos de todo mundo.
      allow get, list: if false;

      // `create` e `update` sob a MESMA condição, de propósito: reivindicar um
      // aparelho que já está em outro dono é o caminho normal, não um ataque.
      allow create, update: if request.auth != null
                            && tokenId.matches('^[0-9a-f]{64}$')
                            && request.resource.data.keys().hasAll(
                                 ['token', 'uid', 'platform', 'updatedAt'])
                            && request.resource.data.keys().hasOnly(
                                 ['token', 'uid', 'platform', 'updatedAt'])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.platform in ['android', 'ios']
                            && request.resource.data.token is string
                            && request.resource.data.token.size() > 0
                            && request.resource.data.token.size() <= 4096
                            // **O id é o hash do token, e a regra confere.**
                            //
                            // Sem esta linha a frase central do desenho seria
                            // falsa: um cliente gravaria o MESMO token sob dois
                            // ids diferentes, com dois donos, e os dois
                            // receberiam — que é exatamente o celular
                            // emprestado que a chave invertida existe para
                            // fechar. "Colisão some por forma" só vale se a
                            // forma for imposta aqui, e não confiada ao app.
                            //
                            // `.lower()` não é detalhe: `toHexString()` devolve
                            // MAIÚSCULO e o `crypto` do Dart gera minúsculo.
                            // Sem ele, toda gravação é negada.
                            && tokenId == hashing.sha256(request.resource.data.token)
                                            .toHexString().lower()
                            // Carimbo do servidor, e não a string ISO que é o
                            // padrão de `updatedAt` no resto do app. É o ÚNICO
                            // campo que a varredura de token velho vai ler, e
                            // deixar o cliente escolher o que é "fresco" é
                            // deixá-lo escolher se expira.
                            && request.resource.data.updatedAt == request.time;

      // O dono retira o próprio aparelho. `resource == null` passa porque
      // apagar documento que não existe é no-op — o mesmo motivo de
      // `friendRequests`: o logout apaga o último id que conhece, e negar o
      // segundo logout seria erro sem consequência.
      allow delete: if request.auth != null
                    && (resource == null
                        || resource.data.uid == request.auth.uid);
    }

    // Rotas de cada usuário: iter/{uid}/routes/{routeId}.
    match /iter/{userId}/routes/{routeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Veículos de cada usuário: iter/{uid}/vehicles/{vehicleId}.
    // Mesma regra das rotas — subcoleção irmã, mesmo dono.
    match /iter/{userId}/vehicles/{vehicleId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Abastecimentos: iter/{uid}/supply/{supplyId}. Idem.
    match /iter/{userId}/supply/{supplyId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Manutenções: iter/{uid}/maintenance/{id}.
    //
    // Sem contraparte global, ao contrário do abastecimento: a oficina é texto
    // livre e nada sai do documento do usuário. Parceria com oficina é ideia
    // de futuro, e quando vier terá regra própria.
    match /iter/{userId}/maintenance/{maintenanceId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Postos e preços — a única coleção do app **sem dono**: qualquer
    // autenticado grava por cima do que outro gravou.
    //
    // Já não é a única compartilhada (`posts`, `reports` e `norouterule` vieram
    // depois), e a frase anterior, que dizia isso, envelheceu sem que nenhum
    // teste ou compilador reclamasse. O que continua verdade é a parte que
    // importa: nas outras, ou a regra prende cada documento ao `uid` de quem
    // escreve, ou ninguém escreve.
    //
    // Existe para um dia indicar preços por perto: quem passa num posto relata
    // quanto pagou, e todos leem. Por isso a leitura é de qualquer autenticado
    // e a escrita não é restrita ao dono do documento — não existe dono.
    match /gastop/{stationId} {
      allow read: if request.auth != null;

      // `updatedBy` tem de ser quem está escrevendo: não impede um preço
      // errado, mas impede escrever em nome de outro.
      allow create, update: if request.auth != null
                            && request.resource.data.updatedBy == request.auth.uid;

      // Ninguém apaga um posto. Se o dado ficar ruim, corrige-se relatando de
      // novo — apagar levaria junto o histórico de todo mundo.
      allow delete: if false;

      // Relatos de preço: cria e pronto.
      //
      // Sem `update` e sem `delete` de propósito. Histórico que pode ser
      // reescrito não é histórico, e é dele que sairá a mediana no dia em que
      // um preço errado precisar ser diluído em vez de acreditado.
      match /precos/{reportId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Regra de pagamento da rota que acabou antes de começar ────────────
    //
    // `norouterule/{empresa}` guarda quanto cada empresa paga quando a rota
    // some do aplicativo depois de aceita: o Mercado Livre paga 40% do valor, a
    // Amazon paga 100%. O id do documento é o nome do valor de `Company`
    // (`mercadolivre`, `amazon`, `shopee`), o mesmo texto que a rota grava em
    // `company` — leitura por id conhecido, sem query e sem índice.
    //
    // É a primeira coleção do app que é **configuração de negócio**, e não dado
    // de usuário. Essa é a diferença que decide a escrita: `gastop` é gravável
    // porque quem passa no posto relata o preço, e o pior caso é um preço
    // errado que a mediana dilui. Aqui não há o que relatar, e um `create`
    // liberado deixa qualquer conta autenticada gravar `{percent: 0}` em
    // `amazon` — zerando o pagamento de **todo mundo** — ou `{percent: 100}` em
    // uma que paga 40, inflando o ganho de todos. Quem edita é o dono, no
    // console, onde a escrita de admin não passa por estas regras.
    //
    // O percentual lido fica **congelado dentro da rota** (`noRoutePayment`),
    // então trocar o número aqui não reescreve nada que já aconteceu. Ver
    // `docs/specs/sem-rota.md`.
    match /norouterule/{company} {
      // `get` e não `read`: `read` é `get` + `list`, e uma condição que não
      // olha `resource` autoriza baixar a coleção inteira. Aqui o estrago seria
      // pequeno — três documentos com um inteiro dentro —, mas a regra da casa
      // veio de `nicknames`, que entregou o mapa apelido → uid da base toda até
      // ser fechada, e exceção é como a próxima coleção volta a ficar aberta.
      //
      // `list` não tem consumidor: o app busca `norouterule/{empresa}` por id e
      // guarda o resultado no estado da tela.
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if false;
    }

    // Reserva de apelidos: o apelido é o ID do documento, então a unicidade
    // é garantida pelo Firestore. `create` só passa quando o documento ainda
    // não existe — é isso que impede dois usuários de pegarem o mesmo.
    match /nicknames/{nickname} {
      // `get` e não `read`: `read` é `get` + `list`, e uma condição que não
      // olha `resource` autoriza baixar a coleção inteira — ou seja, o mapa
      // apelido -> uid de toda a base numa chamada só.
      //
      // Ninguém precisa disso: `resolveUid` e `isAvailable` fazem
      // `docFor(x).get()`, leitura por id. Fechar `list` não quebra consumidor
      // nenhum e tira o dump de graça de quem quiser enumerar os perfis.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && nickname.matches('^[a-z0-9._-]{3,20}$');

      // Sem `update`: trocar de dono exige delete + create, senão alguém
      // poderia sobrescrever a reserva de outra pessoa.
      //
      // `resource == null` cobre apagar reserva inexistente (usuário criado
      // antes desta coleção): sem isso, `resource.data` quebraria a regra e
      // derrubaria o batch inteiro da troca de apelido.
      allow delete: if request.auth != null
                    && (resource == null
                        || resource.data.uid == request.auth.uid);
    }

    // ── Amigos ────────────────────────────────────────────────────────────
    //
    // Primeira feature em que um usuário vê nome e rosto de outro, e primeira
    // regra que autoriza escrever no documento de um terceiro. Ver
    // `docs/specs/amigos.md`.

    // A vitrine pública do perfil.
    //
    // Existe porque `user/{uid}` guarda CPF, e-mail, telefone e data de
    // nascimento — aquele documento nunca abre. Aqui só entra o que o dialog
    // de perfil mostra, e o `hasOnly` é o que garante isso: sem ele, "nunca
    // gravar CPF em profiles" seria convenção, e bastaria um `publish()`
    // futuro copiar um mapa a mais para vazar sem ninguém mexer na regra.
    match /profiles/{userId} {
      // `get`, não `read`: mesma razão de `nicknames` acima. Todo o fluxo é
      // por id conhecido (apelido -> uid -> perfil), então `list` não tem
      // consumidor e listar a coleção seria o cadastro inteiro do app.
      allow get: if request.auth != null;
      allow list: if false;

      // O `get` no apelido impede aparecer como @outrapessoa na lista alheia:
      // a reserva é a fonte da verdade, o perfil é só a cópia de exibição.
      // `hasAll` obriga o mínimo, `hasOnly` fecha o teto. O par importa:
      // `hasOnly` sozinho aceitaria documento sem `name`, e aí
      // `request.resource.data.name` erraria — e erro em regra é negação, o
      // que viraria "não consigo publicar" em vez de "faltou campo".
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasAll(
                        ['uid', 'name', 'updatedAt'])
                   && request.resource.data.keys().hasOnly(
                        ['uid', 'name', 'nickName', 'photoUrl', 'updatedAt'])
                   && request.resource.data.uid == userId
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 80
                   // `getAfter` e não `get`: a troca de apelido cria a reserva
                   // nova e atualiza a projeção **no mesmo batch**, e `get`
                   // enxerga só o estado anterior ao commit — a reserva ainda
                   // não existiria e a regra negaria sempre. Com `getAfter`,
                   // reserva intocada devolve o que já está lá e reserva
                   // criada no batch devolve a nova. Os dois casos passam, e
                   // reivindicar apelido alheio continua negado.
                   && (!('nickName' in request.resource.data)
                       || request.resource.data.nickName == null
                       || getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickName)).data.uid == userId);

      // Os números que o dialog mostra: `all` é a carreira, `2026-08` é o
      // balde do mês que o ranking lê. O `matches` fecha o wildcard — sem
      // ele, a subcoleção é depósito livre na cota do projeto.
      // Os números são de amigo, não de qualquer um.
      //
      // A vitrine acima (nome, foto, apelido) continua pública, porque é o
      // que responde "é essa a pessoa?" antes de existir amizade. Rotas,
      // insucesso e tempo médio não respondem a isso e vazariam a
      // produtividade de todo entregador para quem descobrisse o uid — e o
      // Feed, sendo mural global, entrega uid a quem rolar a tela.
      //
      // `exists` na lista do dono: só quem ele aceitou lê. Custa uma leitura
      // cobrada por documento de estatística.
      match /stats/{bucket} {
        allow get: if request.auth != null
                   && (request.auth.uid == userId
                       || exists(/databases/$(database)/documents/friends/$(userId)/list/$(request.auth.uid)));
        allow list: if false;
        allow write: if request.auth != null
                     && request.auth.uid == userId
                     && (bucket == 'all'
                         || bucket.matches('^[0-9]{4}-[0-9]{2}$'));
      }
    }

    // Convites. O id do documento carrega a identidade do outro lado, então a
    // regra decide sem precisar ler o corpo — mesma técnica de
    // `nicknames/{apelido}`: corpo é dado, caminho é fato.
    //
    // `read` aqui inclui `list` de propósito: a coleção já está sob o uid do
    // dono, então listar só devolve a própria caixa.
    match /friendRequests/{userId}/incoming/{otherId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Só quem envia cria o próprio convite na caixa alheia. Ninguém forja um
      // convite "de" outra pessoa — e é essa impossibilidade que sustenta a
      // regra de `friends` lá embaixo.
      // Os **dois** perfis têm de existir. O de quem recebe impede convidar
      // um uid inventado; o de quem envia é o que garante que dá para saber
      // quem convidou — sem ele o convite chega como "Entregador", e aceitar
      // ou recusar sem saber de quem é não é decisão, é chute.
      //
      // E ninguém convida quem o bloqueou. Sem esta linha, quem foi recusado
      // reconvida para sempre e acende o badge toda vez — era a dívida
      // "bloquear uma pessoa" da spec, e ela cabia numa regra.
      allow create: if request.auth != null
                    && request.auth.uid == otherId
                    && otherId != userId
                    && exists(/databases/$(database)/documents/profiles/$(userId))
                    && exists(/databases/$(database)/documents/profiles/$(otherId))
                    && !bloqueioEntre(database, userId, otherId)
                    && request.resource.data.keys().hasOnly(['at'])
                    && request.resource.data.at == request.time;

      // Os dois lados apagam: o dono recusa, quem enviou retira. A condição
      // não toca em `resource`, então apagar marcador inexistente passa — é o
      // que deixa o aceite apagar os quatro caminhos do convite mútuo sem
      // precisar saber quais existem.
      allow delete: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == otherId);

      allow update: if false;
    }

    match /friendRequests/{userId}/outgoing/{otherId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // **Sem `bloqueioEntre` aqui, de propósito.** O convite é um `WriteBatch`
      // com os dois documentos, e batch é atômico: negar o `incoming` já nega
      // o convite inteiro. Repetir a checagem neste lado não protegia mais
      // nada e criava um **oráculo silencioso** — este documento mora no
      // subtree de quem escreve, então bastava eliminar as outras condições
      // (o perfil se lê, a própria lista de bloqueio se lê) e sondar: negado
      // significava "ela me bloqueou", com certeza, sem rastro do lado dela e
      // repetível. Com o `uid` de todo mundo saindo do `list` de `posts`, isso
      // era o mapa de quem te bloqueou na base inteira.
      //
      // A sonda que sobra é escrever direto na caixa da vítima, e essa, quando
      // passa, **acende o badge dela**. Oráculo barulhento em vez de
      // silencioso é a diferença que dá para conseguir sem servidor.
      //
      // Um marcador `outgoing` solto não vira amizade: a aresta exige o
      // `incoming` da vítima, que só ela cria.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && otherId != userId
                    && exists(/databases/$(database)/documents/profiles/$(userId))
                    && exists(/databases/$(database)/documents/profiles/$(otherId))
                    && request.resource.data.keys().hasOnly(['at'])
                    && request.resource.data.at == request.time;

      allow delete: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == otherId);

      allow update: if false;
    }

    // ── Bloqueio ──────────────────────────────────────────────────────────
    //
    // `blocks/{uid}/list/{otherId}`: a lista é do dono e **só ele lê**.
    //
    // O que isso NÃO garante, e uma versão anterior deste comentário afirmava
    // que sim: opacidade. `permission-denied` **é** distinguível de "sem
    // rede" — escrita offline fica pendente no SDK, negada volta na hora — e
    // quem sonda elimina as outras condições antes (o perfil se lê, a própria
    // lista de bloqueio se lê). **O bloqueio impede o contato; não esconde que
    // existe.** O que dá para conseguir sem servidor é que a sonda seja
    // barulhenta — ver `friendRequests/outgoing` —, e limitar sonda em escala
    // é trabalho de App Check, não de regra.
    //
    // Bloquear é um `WriteBatch` que também apaga as duas arestas de amizade e
    // os quatro marcadores de convite: um marcador vivo continua autorizando
    // recriar a aresta, e a amizade ressuscitaria depois do bloqueio.
    match /blocks/{userId}/list/{otherId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // `create, update` sob a mesma condição, como a aresta de amizade:
      // bloquear duas vezes é a mesma intenção, e um `update: if false`
      // transformaria o segundo toque em permission-denied.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && otherId != userId
                            && request.resource.data.keys().hasOnly(['at'])
                            && request.resource.data.at == request.time;

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // A aresta de amizade.
    //
    // A propriedade que esta regra garante: uma aresta X -> Y só nasce se o
    // par trocou um convite na direção que a justifica, e nunca sozinha.
    match /friends/{userId}/list/{friendId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // `create, update` com a MESMA condição, de propósito: a escrita é
      // idempotente. `set` sobre documento existente é `update`, e um
      // `update: if false` transformaria qualquer reparo — ou um segundo
      // toque em "Aceitar" — em permission-denied permanente.
      allow create, update: if request.auth != null
        && friendId != userId
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time

        // As duas arestas nascem no mesmo commit, ou nenhuma nasce.
        // `existsAfter` enxerga o estado depois do batch e antes do commit, e
        // é o que dispensa Cloud Functions para ter atomicidade entre
        // documentos. `exists`, logo abaixo, enxerga o estado *anterior* — é
        // por isso que o aceite consulta um marcador que ele mesmo apaga no
        // mesmo batch.
        && existsAfter(/databases/$(database)/documents/friends/$(friendId)/list/$(userId))

        && (
             // aceito o que me mandaram: escrevo na minha lista
             (request.auth.uid == userId
              && exists(/databases/$(database)/documents/friendRequests/$(userId)/incoming/$(friendId)))

             // aceito o que me mandaram: me insiro na lista de quem convidou
          || (request.auth.uid == friendId
              && exists(/databases/$(database)/documents/friendRequests/$(userId)/outgoing/$(friendId)))
        );

      // Qualquer um dos dois desfaz, inclusive me remover da lista alheia.
      // Sem `existsAfter` aqui: prender a remoção também acrescentaria um modo
      // de falha a um caminho que não tem consentimento em jogo — o pior caso
      // é o outro continuar vendo a amizade até remover por conta própria.
      allow delete: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == friendId);
    }

    // ── Feed ──────────────────────────────────────────────────────────────
    //
    // O mural. É a coleção global mais exposta do app, e por isso a mais
    // validada — não o contrário, que foi o erro do primeiro esboço.

    match /posts/{postId} {
      allow get, list: if request.auth != null;

      // Sem `hasOnly` o cliente inventa campo; sem teto de tamanho grava
      // 1 MiB numa coleção que todo mundo lista; sem
      // `createdAt == request.time` um post com data de 9999 fica em primeiro
      // lugar no feed de todo mundo para sempre.
      //
      // O último é o mesmo ataque que a regra de `friends` já fecha no `at`:
      // ordenar por dado do adversário. Lá a lista é de um usuário; aqui é de
      // todos.
      //
      // O **id** também é validado, e não por capricho: ele é escolhido pelo
      // cliente e entra no id da denúncia (`p_{postId}__{uid}`). Sem teto,
      // quem publica escolhe um id de 1490 bytes e a denúncia estoura o limite
      // de 1500 do Firestore — o post fica **imdenunciável para sempre**, que
      // é o mesmo "gesto que torna a ofensa permanente" do tombstone, só que
      // escolhido pelo agressor. E sem o `_` fora do alfabeto, o separador do
      // id da denúncia fica ambíguo. `Uuid().v4()` é hex e hífen: cabe.
      allow create: if request.auth != null
                    && postId.matches('^[A-Za-z0-9-]{1,64}$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(
                         ['uid', 'text', 'createdAt', 'deleted'])
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'text', 'company', 'imagePath',
                          'createdAt', 'deleted'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.deleted == false
                    // `in` antes de comparar: `data.company` numa chave
                    // ausente **erra**, e erro em regra nega. Post sem
                    // empresa e sem foto é o caso comum, não a exceção.
                    && (!('company' in request.resource.data)
                        || request.resource.data.company == null
                        || request.resource.data.company in
                             ['mercadolivre', 'amazon', 'shopee'])
                    // Sem isto, o post carrega a imagem de outra pessoa.
                    && (!('imagePath' in request.resource.data)
                        || request.resource.data.imagePath == null
                        || request.resource.data.imagePath.matches(
                             '^posts/' + request.auth.uid + '/.*'));

      // **Apagar é marcar.** O Firestore não apaga subcoleções em cascata:
      // com `delete` de verdade, as curtidas sobreviveriam ao post, o id
      // voltaria a ficar livre — um post novo herdaria a thread do anterior —
      // e o `get()` da moderação passaria a errar, que é o mesmo que negar.
      // Apagar o post seria o gesto que torna a ofensa permanente.
      //
      // **`affectedKeys` diz QUAIS chaves mudaram, nunca o valor delas.** Só
      // com ele, o `update` era a porta de trás do `create`: um post nasce com
      // 10 caracteres e a lápide grava 1 MiB de texto, num documento que
      // `delete: if false` torna **indelével**, numa coleção com `list`
      // aberto; e o `imagePath` escapava do `^posts/{meu uid}/` que só o
      // `create` exigia, passando a apontar para a foto de outra pessoa no
      // Storage. Por isso a lápide é presa à forma exata que
      // `PostController.erase` grava, e não a um conjunto de chaves.
      allow update: if request.auth != null
                    // O admin remove post denunciado gravando ESTA MESMA
                    // lápide: ele não ganha update arbitrário, ganha o
                    // direito à única forma que já era permitida — a pinagem
                    // abaixo vale para ele também.
                    && (resource.data.uid == request.auth.uid || isAdmin())
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['deleted', 'text', 'imagePath'])
                    && request.resource.data.deleted == true
                    && request.resource.data.text == ''
                    && (!('imagePath' in request.resource.data)
                        || request.resource.data.imagePath == null);

      allow delete: if false;

      // Uma curtida = um documento, o id é quem curtiu. A unicidade sai de
      // graça: ninguém curte duas vezes, e não há contador para conciliar.
      //
      // O `uid` no corpo é redundante com o id de propósito: sem ele,
      // `collectionGroup('likes').where('uid','==',eu)` é impossível e saber
      // quais dos 20 posts da tela eu já curti vira 20 leituras. A regra
      // confere os dois, então não abre personificação.
      match /likes/{likerId} {
        allow get, list: if request.auth != null;

        // `get` e não `exists`: **lápide também existe**, e curtir um post
        // apagado é escrever numa subcoleção que nenhuma tela mostra. `get` de
        // documento inexistente devolve null, `.data` erra e erro nega, então
        // ele faz os dois trabalhos por uma leitura só.
        //
        // `.get('deleted', false)` e não `.deleted`: chave ausente **erra**, e
        // um post do acervo antigo sem o campo viraria "não dá para curtir",
        // em silêncio.
        allow create: if request.auth != null
                      && request.auth.uid == likerId
                      && request.resource.data.keys().hasOnly(['uid', 'at'])
                      && request.resource.data.uid == likerId
                      && request.resource.data.at == request.time
                      && get(/databases/$(database)/documents/posts/$(postId))
                           .data.get('deleted', false) == false;

        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == likerId;
      }

      // Comentário: texto livre de uma pessoa aparecendo embaixo do post de
      // outra. Quem publica assume o que escreve; **quem é comentado não
      // escolheu** — é por isso que esta subcoleção só sobe depois de o
      // bloqueio e a denúncia existirem.
      //
      // `list` liberado aqui, ao contrário de `profiles` e `nicknames`: a
      // subcoleção está sob um post, então listar devolve os comentários
      // daquele post e nada mais. Fechar `list` é sobre não deixar enumerar a
      // base inteira, não sobre proibir listagem.
      //
      // Ordena por `createdAt`, campo único em subcoleção: **não** precisa de
      // índice composto.
      match /comments/{commentId} {
        allow get, list: if request.auth != null;

        allow create: if request.auth != null
                      && commentId.matches('^[A-Za-z0-9-]{1,64}$')
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.keys().hasAll(
                           ['uid', 'text', 'createdAt'])
                      && request.resource.data.keys().hasOnly(
                           ['uid', 'text', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.createdAt == request.time
                      // O post tem de existir **e estar vivo**, e o `get` faz
                      // os dois: `get` de documento inexistente devolve null,
                      // `.data` erra e erro nega — é o que fecha o depósito de
                      // lixo em `posts/<id-inventado>/comments`.
                      //
                      // **Lápide também existe**, e era por aí que o gesto de
                      // quem foi ofendido — apagar o próprio post — deixava a
                      // thread viva: aceitando texto novo, legível por quem
                      // tivesse o id, e invisível para o dono, que passava a
                      // moderar às cegas.
                      //
                      // `.get('deleted', false)` e não `.deleted`: chave
                      // ausente erra, e um post do acervo antigo sem o campo
                      // viraria "não dá para comentar", em silêncio.
                      && get(/databases/$(database)/documents/posts/$(postId))
                           .data.get('deleted', false) == false
                      // Bloqueado não comenta, e é esta linha que faz o
                      // bloqueio valer alguma coisa aqui. O filtro do cliente
                      // some com o comentário na **minha** tela; sem a regra,
                      // ele continua visível para todo mundo embaixo do meu
                      // post.
                      && !bloqueioEntre(
                           database,
                           get(/databases/$(database)/documents/posts/$(postId)).data.uid,
                           request.auth.uid);

        // Sem `update`, como o histórico de preço do posto: comentário que
        // pode ser reescrito depois de alguém responder não é comentário.
        allow update: if false;

        // Moderação sem servidor: o dono do post apaga qualquer comentário do
        // próprio post. Quem foi comentado não escolheu ser comentado, e essa
        // é a diferença entre curtida e comentário.
        //
        // Só funciona porque o post nunca é apagado de verdade — com `delete`
        // real o `get()` erraria, e erro em regra nega justamente quando mais
        // importa.
        allow delete: if request.auth != null
                      && resource != null
                      && (resource.data.uid == request.auth.uid
                          || get(/databases/$(database)/documents/posts/$(postId))
                               .data.uid == request.auth.uid
                          // E o admin, para o comentário denunciado que o
                          // dono do post não removeu — mesma moderação, um
                          // moderador a mais.
                          || isAdmin());
      }

      // Os marcos já anunciados deste post: `curtidas_10`, `comentarios_5`.
      //
      // **Escrita só pelo Admin SDK, que não passa por aqui** — e é exatamente
      // por isso que esta regra precisa existir. Sem ela a coleção funcionaria
      // igual, e ninguém notaria que qualquer conta autenticada podia
      // **pré-criar** o marcador de um post alheio para emudecer o aviso, ou
      // apagá-lo para fazer o mesmo marco ser anunciado de novo, quantas vezes
      // quisesse. A supressão é invisível para os dois lados.
      //
      // `read` fechado junto: a lista de marcos entrega quantas curtidas um
      // post já teve ao longo do tempo, que é mais do que a tela mostra.
      match /marcos/{marcoId} {
        allow read, write: if false;
      }
    }

    // ── Denúncia ──────────────────────────────────────────────────────────
    //
    // Não há servidor, então **o documento é o canal**: a fila é lida no
    // painel admin (`site/admin.html`), que passa por estas regras — ao
    // contrário do console, que segue servindo como rota de emergência. Uma
    // Function que notifica a chegada de denúncia continua sendo o passo
    // seguinte — e continua custando dinheiro por uso.
    match /reports/{reportId} {
      // Só o admin lê: a fila é o canal DELE. Para todo o resto continua
      // fechada, quem denunciou incluído — uma coleção de denúncias legível
      // é a lista de quem delatou quem, e entre entregadores que se conhecem
      // do galpão isso é pior do que o conteúdo denunciado.
      allow get, list: if isAdmin();

      // O id é `p_{postId}__{quem}` ou `c_{postId}_{commentId}__{quem}` — a
      // técnica de `nicknames/{apelido}` outra vez: uma denúncia por pessoa
      // por alvo, garantida pela **forma** do dado, sem contador e sem
      // corrida.
      //
      // `create, update` sob a mesma condição porque denunciar de novo não
      // pode virar permission-denied na cara de quem denuncia: a segunda
      // sobrescreve a primeira e continua sendo uma.
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(
             ['uid', 'postId', 'reason', 'at'])
        && request.resource.data.keys().hasOnly(
             ['uid', 'postId', 'commentId', 'reason', 'at'])
        && request.resource.data.at == request.time
        // Motivo de lista fechada, não texto livre. O campo existe para triar
        // a fila; um campo de texto que só o dono do app lê seria um canal de
        // recado que ninguém pediu — e o primeiro lugar onde alguém escreveria
        // o nome e o telefone de outra pessoa.
        && request.resource.data.reason in
             ['spam', 'ofensa', 'improprio', 'golpe', 'outro']
        && reportId == idDaDenuncia(request.resource.data, request.auth.uid)
        // **Denúncia é sobre conteúdo alheio**, e o `get` no autor é o que diz
        // isso. De quebra ele nega alvo inexistente sozinho: `get` de
        // documento que não existe devolve null e `.data` erra.
        //
        // Um `exists` puro só proibia denunciar o que não existe — não
        // proibia **fabricar** o que existe. Uma conta só publicava um
        // comentário, denunciava a si mesma, apagava o comentário e repetia:
        // cada volta deixava um documento permanente em `reports`, com
        // `delete: if false` e `get/list: if false`, que nem o dono do app
        // alcança pelo cliente. Milhares por dia, soterrando o único canal de
        // moderação que a feature tem.
        //
        // O que isto **não** faz é limitar volume: duas contas em conluio
        // fabricam alvo alheio de verdade. Teto de coleção global gravável não
        // sai de regra — sai de App Check, que segue pendente.
        && (denunciaDeComentario(request.resource.data)
              ? get(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)).data.uid != request.auth.uid
              : get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid != request.auth.uid);

      // Denúncia que se apaga não é denúncia — mesma razão de `precos` não ter
      // `update` nem `delete`.
      allow delete: if false;
    }

    // ── Baixa de moderação ────────────────────────────────────────────────
    //
    // `moderation/{alvo}` registra que o admin já tratou aquele alvo; a fila
    // pendente do painel é `reports` menos os alvos presentes aqui. O id é o
    // **alvo** (`p_{postId}` ou `c_{postId}_{commentId}`), não o id da
    // denúncia: três pessoas denunciando o mesmo post são três documentos em
    // `reports` e UMA decisão — a baixa por alvo resolve as três de uma vez,
    // sem varrer sufixos `__{uid}`.
    //
    // A denúncia em si permanece intocada — "denúncia que se apaga não é
    // denúncia" —, e é por isso que a baixa é coleção à parte, e não um campo
    // em `reports`, cujo `update` está preso à forma de quem denuncia.
    //
    // `resolution` é lista fechada, como o `reason` da denúncia e pela mesma
    // razão: texto livre seria canal de recado. `delete: if false`: baixa
    // errada se corrige sobrescrevendo (o `update` passa pela mesma condição),
    // não apagando — apagar devolveria o alvo à fila sem dizer por quê.
    match /moderation/{targetId} {
      allow get, list: if isAdmin();

      // O regex prende o id à forma dos alvos reais: uma baixa que não casa
      // com denúncia nenhuma não dá baixa em nada, e o `_` fora do alfabeto
      // dos ids de post/comentário é o que mantém o separador sem ambiguidade
      // — a mesma razão do prefixo em `idDaDenuncia`.
      allow create, update: if isAdmin()
                            && (targetId.matches('^p_[A-Za-z0-9-]{1,64}$')
                                || targetId.matches('^c_[A-Za-z0-9-]{1,64}_[A-Za-z0-9-]{1,64}$'))
                            && request.resource.data.keys().hasAll(
                                 ['resolution', 'at'])
                            && request.resource.data.keys().hasOnly(
                                 ['resolution', 'at'])
                            && request.resource.data.resolution in
                                 ['removido', 'ignorado']
                            && request.resource.data.at == request.time;

      allow delete: if false;
    }

    // ── Quarentena da moderação automática ───────────────────────────────
    //
    // `quarentena/{alvo}` guarda o ORIGINAL do que a máquina removeu — a
    // lápide destrói (`text: ''`, sem volta pelas regras), e a cópia existe
    // pelos dois erros possíveis: se a máquina errou, é o que permite
    // restaurar; se acertou, é evidência, e evidência não se destrói — se
    // preserva e se denuncia. Ver `docs/specs/moderacao-automatica.md`.
    //
    // Quem escreve é só o Admin SDK (`functions/moderacao.js`), que não
    // passa por aqui — a regra existe pela razão de `avisosRanking`: sem
    // ela tudo funcionaria igual, e ninguém notaria que qualquer conta
    // autenticada podia ler o acervo do pior conteúdo do app, ou gravar
    // por cima da evidência.
    //
    // O admin lê pelo painel, para julgar o julgamento da máquina.
    match /quarentena/{targetId} {
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // ── Marcadores de notificação ─────────────────────────────────────────
    //
    // `avisosRanking/{passado}_{passador}_{criterio}_{mes}_{dia}` — o teto de um
    // aviso de ultrapassagem por par, por critério, por dia.
    //
    // **O documento É a trava**: `create()` do Admin SDK falha quando o id já
    // existe, então não há leitura, nem transação, nem contador para conciliar.
    // A técnica é a de `nicknames/{apelido}` — mas a semelhança para aqui, e o
    // comentário precisa dizer por quê: em `nicknames` o documento **é** o fato
    // reivindicado, e a colisão aparece na cara de quem tenta. Aqui ele é uma
    // afirmação derivada, e a colisão é invisível para os dois lados — quem
    // deveria receber nunca soube que havia algo para receber.
    //
    // Por isso `if false` para todo mundo, como `norouterule`: se um cliente
    // pudesse criar marcador, pré-criar o do vizinho o emudeceria pelo dia
    // inteiro, sem rastro. É a segunda coleção de infraestrutura do projeto, e a
    // segunda em que o cliente não tem nada a fazer. O Admin SDK ignora regras e
    // continua escrevendo — e é justamente por isso que a ausência de regra
    // passaria despercebida.
    //
    // O uid vem **antes** da data no id: data no prefixo joga todas as escritas
    // do dia numa faixa contígua de chaves, que é o anti-padrão de hotspot que o
    // Google documenta. Nesta escala não chega perto do limite; a ordem certa
    // custa zero e sobrevive ao dia em que chegar.
    //
    // Ver `docs/specs/notificacoes.md`.
    match /avisosRanking/{avisoId} {
      allow read, write: if false;
    }

    // O espelho do dono: `iter/{uid}/posts/{id}`, mesmo id do global, gravado
    // no mesmo batch. É o par que `gastop` + `supply` já fazem, e é o que
    // resolve "minhas postagens" sem query nem índice na coleção global.
    match /iter/{userId}/posts/{postId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
